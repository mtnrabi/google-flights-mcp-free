# ── Backend ──────────────────────────────────────────────────────────────
# Same API Lambda and auth header the Apify actor uses. BASE_LAMBDA_URL is in
# apify_actor/.env; RAPID_AUTH is in backend/.env. A wrong secret is a 403.
BASE_LAMBDA_URL=
RAPID_AUTH=
LAMBDA_TIMEOUT_SECONDS=105

# ── Lulu ads ─────────────────────────────────────────────────────────────
# Register once:
#   curl -X POST https://ads.getlulu.dev/publishers \
#     -H 'content-type: application/json' \
#     -d '{"name":"flight-powers-free","contact_email":"...","server_url":"..."}'
# The API key is returned exactly once.
LULU_ADS_PUBLISHER_ID=
LULU_ADS_API_KEY=
ADS_ENABLED=true

# CRITICAL: must be the exact public URL clients connect to, including the
# path and with NO trailing slash (/mcp/ answers via a 307, but the hash is
# taken over this literal string). Lulu derives Claude's _meta.ui.domain from
# it, and the sponsored widget silently renders nothing on a mismatch --
# zero CPM, no error anywhere. The server logs the derived domain at startup.
MCP_PUBLIC_URL=https://your-project.vercel.app/mcp

# ── Cost control ─────────────────────────────────────────────────────────
# One user intent can expand to dozens of backend calls, but earns at most one
# rendered ad. Backend fan-out is capped per tool call; the range is sampled
# evenly rather than truncated, and the reduction is reported to the caller.
MAX_BACKEND_CALLS_PER_TOOL_CALL=15
MAX_CONCURRENT_BACKEND_CALLS=10

# Ceiling on the shared outbound connection pool. Vercel functions share
# 1,024 file descriptors across ALL concurrent executions on an instance, and
# sockets come out of that pool.
MAX_HTTP_CONNECTIONS=60

# Rolling 24h ceiling on total backend calls. 0 disables the guard.
# At BUDGET_DEGRADE_AT of the budget the per-call cap drops to a third; at
# 100% it drops to 1. Degrading beats refusing -- a hard stop looks like an
# outage to every user for the rest of the day.
#
# NOTE: on serverless this is only enforceable with the shared counter store
# below. Without it, counters are per-instance and real spend silently
# exceeds the budget. /metrics reports budget.enforceable so you can tell.
DAILY_BACKEND_CALL_BUDGET=0
BUDGET_DEGRADE_AT=0.8

# ── Shared counters (required on Vercel, optional in a container) ─────────
# Vercel's filesystem is read-only outside an ephemeral /tmp and Fluid
# compute spreads requests across instances, so in-process counters fragment
# and reset. Upstash Redis makes the totals and the spend guard real.
#   vercel install upstash     (injects these automatically)
# Stores migrated off the retired Vercel KV use KV_REST_API_URL/_TOKEN
# instead; both names are recognised.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Enforcement ──────────────────────────────────────────────────────────
# off      serve everyone at the full cap, classify nothing
# monitor  classify and log, still serve everyone (recommended for week one)
# enforce  apply per-tier caps and the blocklist
ENFORCEMENT_MODE=monitor

# Comma-separated tiers to refuse when ENFORCEMENT_MODE=enforce.
# Tiers: llm_host (Anthropic/OpenAI egress), local_client (Claude Code,
# Cursor -- text card only, structurally no CPM), unknown.
BLOCKED_TIERS=

# ── Serving ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEFAULT_RESULT_LIMIT=10

# Optional second log sink. Every tool call ALWAYS emits one JSON line to
# stdout prefixed "MCP_CALL " -- that is the record, and it is what Vercel
# captures. Set this only when running as a container with a writable path;
# leave it empty on Vercel, where the filesystem is read-only outside /tmp.
# The sink disables itself rather than appending into a void.
LOG_PATH=

# Optional. When set, /metrics requires header: x-metrics-token: <value>
METRICS_TOKEN=
