# ── Backend ──────────────────────────────────────────────────────────────
# Same API Lambda and auth header the Apify actor uses. BASE_LAMBDA_URL is in
# apify_actor/.env; RAPID_AUTH is in backend/.env. A wrong secret is a 403.
BASE_LAMBDA_URL=
RAPID_AUTH=
# Defaults to 75 = the deployed function's Timeout (60, read live 2026-08-27)
# plus a 15s transit margin. It must stay ABOVE the function Timeout: below it,
# the server abandons searches the backend was about to answer. Leave unset
# unless a deployment genuinely needs to differ.
LAMBDA_TIMEOUT_SECONDS=

# ── Lulu ads ─────────────────────────────────────────────────────────────
# Register once:
#   curl -X POST https://ads.getlulu.dev/publishers \
#     -H 'content-type: application/json' \
#     -d '{"name":"flight-powers-free","contact_email":"...","server_url":"..."}'
# The API key is returned exactly once.
LULU_ADS_PUBLISHER_ID=
LULU_ADS_API_KEY=
ADS_ENABLED=true

# CRITICAL: must be the exact public URL clients connect to, including the
# path and with NO trailing slash (/mcp/ answers via a 307, but the hash is
# taken over this literal string). Lulu derives Claude's _meta.ui.domain from
# it, and the sponsored widget silently renders nothing on a mismatch --
# zero CPM, no error anywhere. The server logs the derived domain at startup.
MCP_PUBLIC_URL=https://your-project.vercel.app/mcp

# ── Cost control ─────────────────────────────────────────────────────────
# One user intent can expand to dozens of backend calls, but earns at most one
# rendered ad. Backend fan-out is capped per tool call; the range is sampled
# evenly rather than truncated, and the reduction is reported to the caller.
MAX_BACKEND_CALLS_PER_TOOL_CALL=15
MAX_CONCURRENT_BACKEND_CALLS=10

# Ceiling on the shared outbound connection pool. Vercel functions share
# 1,024 file descriptors across ALL concurrent executions on an instance, and
# sockets come out of that pool.
MAX_HTTP_CONNECTIONS=60

# Rolling 24h ceiling on total backend calls. 0 disables the guard.
# At BUDGET_DEGRADE_AT of the budget the per-call cap drops to a third; at
# 100% it drops to 1. Degrading beats refusing -- a hard stop looks like an
# outage to every user for the rest of the day.
#
# NOTE: on serverless this is only enforceable with the shared counter store
# below. Without it, counters are per-instance and real spend silently
# exceeds the budget. /metrics reports budget.enforceable so you can tell.
DAILY_BACKEND_CALL_BUDGET=0
BUDGET_DEGRADE_AT=0.8

# ── Sign in with Google (required for every call since 2026-09-09) ───────
# `/mcp` answers 401 + the OAuth challenge to a call with no access token, so
# every served request belongs to a Google account and every allowance is
# that account's own. The feature registers NOTHING unless all three of the
# variables below are set: no GOOGLE_OAUTH_CLIENT_ID, no DATABASE_URL, and
# the server is exactly what it was -- /mcp open, /mcp/oauth a 404. That is
# also the rollback.
#
# Google Cloud Console -> Credentials -> OAuth client ID, type Web
# application. ONE authorised redirect URI:
#   https://free-trial.flightpowers.com/connect/callback
# Consent screen scopes: `openid` and `.../auth/userinfo.email`. Nothing else.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Neon Postgres, the POOLED endpoint (`...-pooler...`). Holds the sign-in
# rows and the OAuth clients, codes and tokens. Tables are created by
# `migrations/001_free_mcp_signin.sql`, and they are `free_mcp_*` -- a token
# minted here must never be one the paid server would accept.
DATABASE_URL=

# Optional. The HMAC key under which the browser session cookie and the
# consent form are signed. Unset (the normal state) derives it from
# GOOGLE_OAUTH_CLIENT_SECRET, which this deployment already holds: this
# server stores no secret of the user's, so there is no ciphertext a lost key
# would strand. Set it only to stage a rotation independently of Google.
MCP_SIGNIN_SECRET=

# `challenge` (the default, and what ships) requires a sign-in for every
# call. `open` is the ROLLBACK: /mcp answers anonymous callers again, capped
# at FREE_ANON_DAILY_CAP. /mcp/oauth always challenges whatever this says.
#
# NOT "one env var, no deploy" -- that claim cost an incident on 2026-09-09.
# Two things have to be true for the flip to change anything:
#   1. On Vercel an env var is baked into a DEPLOYMENT. Set it, then
#      `vercel redeploy <prod-url>` (which re-reads project env and keeps the
#      target), then confirm with `GET /health` -> "anon_mode": "open". If
#      health still says "challenge", the running code never saw it.
#   2. `open` grants FREE_ANON_DAILY_CAP against the SAME per-day counter
#      those callers were spending at the ordinary cap. Anyone already past
#      10 today stays refused, which looks exactly like "the switch did
#      nothing". To restore service rather than offer a taster, raise
#      FREE_ANON_DAILY_CAP to the ordinary day cap in the same redeploy.
# `initialize` and `tools/list` are never refused by a cap in either mode, so
# a client can always connect and read the directions.
FREE_ANON_MODE=

# Only meaningful under FREE_ANON_MODE=open: what an anonymous caller gets.
# 10 a day is exactly the RapidAPI BASIC monthly quota, so it reads as "a day
# of what BASIC gives you in a month" rather than a plan to build on. 0 in
# the month field means that limit is off.
FREE_ANON_DAILY_CAP=10
FREE_ANON_MONTHLY_CAP=0

# ── The upsell list (Resend) ─────────────────────────────────────────────
# The Neon table IS the list. Resend's plan caps this account at three
# audiences/segments and all three are in use, so there is no audience to add
# anyone to; the transactional sends go through POST /emails, which needs
# none. See src/maillist.py.
RESEND_API_KEY=
# PHASE 2 ONLY, and empty is the shipped state: with no id the server makes
# no request to Resend's contact API at all. When a slot frees, the sync GETs
# before it POSTs -- POST /contacts on an existing address UPSERTS it and
# resets `unsubscribed` to false, which would re-subscribe everyone who has
# ever opted out.
RESEND_FREE_AUDIENCE_ID=
# `on` sends the welcome note at first sign-in. Default OFF so the code can
# ship and be verified before a single email leaves.
FREE_SIGNIN_WELCOME=
# `on` sends the cap note: one message to somebody who hit the daily cap on
# two days inside a week, or who is 60% through the month with five days
# left. At most one per user per 30 days, never inside 72 hours of the
# welcome, at most 20 across the lane per UTC day. Its own switch and not
# the welcome's, deliberately -- the welcome is half a receipt, this is an
# upsell, and CLAUDE.md rule 14 is what happens when upsell notes are sent
# on a schedule instead of on a trigger. Default OFF.
FREE_SIGNIN_CAPNOTE=
# Where /email/unsubscribe lives for the links we print. Defaults to this
# deployment's own origin; set it to https://flightpowers.com once the site
# proxies that route, so a footer link is on the brand domain.
FREE_UNSUBSCRIBE_BASE=

# ── Fair use, per account ────────────────────────────────────────────────
# The budget above is a TOTAL, so one scheduled client can spend it and every
# other caller gets a degraded server for the rest of the day. That is what
# happened: on 2026-09-05 one caller was 3,270 of 4,078 backend calls in 30
# hours. These caps are PER CLIENT and count BACKEND calls, which is the unit
# that costs money -- one tool call with a two-week date range is fourteen.
#
# The month cap is the one that matters: 150/day for a month is 4,500, and
# RapidAPI PRO is 2,500 requests for $10. Free must not beat the cheapest
# paid plan. Past either cap the tools answer with search_status
# "rate_limited" and an upgrade object saying how to get a key.
#
# The client is sha256(x-forwarded-for + user-agent), truncated -- no session
# id, because the client this exists for opens one session per request. A
# request carrying neither header is not counted and never refused.
#
# Enforced from day one; FAIR_USE_ENABLED=0 turns off the caps AND the
# upgrade prose in the instructions and tool descriptions. Needs the shared
# store below: per-instance counters mean a fresh allowance on every cold
# start, which is a delay rather than a cap.
FAIR_USE_ENABLED=1
# Per Google account since 2026-09-09, not per IP-and-user-agent digest.
FAIR_USE_DAY_CAP=150
FAIR_USE_MONTH_CAP=2000

# The same two caps for a POOLED key. A remote host -- claude.ai, ChatGPT,
# Smithery -- terminates the end user's connection and opens its own to us, so
# every user behind it arrives with the same forwarded IP and user agent. At
# 150 a day those users refuse each other while a direct script is capped
# exactly as intended, so a caller from a published LLM-host egress range gets
# its own, higher pair, split by mcp-session-id where there is one.
FAIR_USE_GATEWAY_DAY_CAP=1500
FAIR_USE_GATEWAY_MONTH_CAP=10000

# Extra CIDRs to treat as gateway egress, comma-separated. Anthropic's
# published 160.79.104.0/21 and OpenAI's published connector feed are already
# known. Empty by default: an unverified range here hands the higher caps to
# whoever is in it.
FAIR_USE_GATEWAY_CIDRS=

# User-agent substrings to treat as gateway egress. EMPTY by default and
# deliberately so: Smithery publishes no IP range (its own advice is to
# allowlist User-Agent SmitheryBot/1.0, and its gateway runs on Cloudflare
# Workers), so this is the only handle on it -- and a user agent is a string
# the caller types. Setting `smithery` stops real Smithery users sharing one
# 150-a-day counter, and lets anyone claim the higher caps by copying a
# header. Turn it on when a `[fair_use] action=block kind=direct` line says
# it is needed, not before.
FAIR_USE_GATEWAY_USER_AGENTS=

# Extra query parameters carrying a PER-USER value a gateway injects.
# `config` and `config.<field>` are always read; this names anything else a
# gateway is observed to send. Never list a gateway's own `api_key` -- it is
# the same value for every user behind it.
FAIR_USE_IDENTITY_PARAMS=

# How many soft refusals one client may collect in a ROLLING hour before the
# server stops answering it at the MCP layer and returns HTTP 429 with a
# Retry-After header instead. 0 keeps the soft refusal as the only behaviour.
#
# The soft refusal is a 200 whose body says search_status "rate_limited",
# which is the right answer for a model and worth nothing to a script. On
# 2026-09-06 the 04:00Z batch client was refused at its 150th backend call and
# then made 486 more tool calls in 24 minutes, because nothing in its code
# reads a body. A status code is the one signal every HTTP client already
# understands. Pooled gateway keys are exempt -- one of those stands for an
# unknown number of real people.
FAIR_USE_HARD_AFTER=20

# ── Shared counters (required on Vercel, optional in a container) ─────────
# Vercel's filesystem is read-only outside an ephemeral /tmp and Fluid
# compute spreads requests across instances, so in-process counters fragment
# and reset. Upstash Redis makes the totals and the spend guard real.
#   vercel install upstash     (injects these automatically)
# Stores migrated off the retired Vercel KV use KV_REST_API_URL/_TOKEN
# instead; both names are recognised.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Enforcement ──────────────────────────────────────────────────────────
# off      serve everyone at the full cap, classify nothing
# monitor  classify and log, still serve everyone (recommended for week one)
# enforce  apply per-tier caps and the blocklist
ENFORCEMENT_MODE=monitor

# Comma-separated tiers to refuse when ENFORCEMENT_MODE=enforce.
# Tiers: llm_host (Anthropic/OpenAI egress), local_client (Claude Code,
# Cursor -- text card only, structurally no CPM), unknown.
BLOCKED_TIERS=

# ── Serving ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEFAULT_RESULT_LIMIT=10

# Optional second log sink. Every tool call ALWAYS emits one JSON line to
# stdout prefixed "MCP_CALL " -- that is the record, and it is what Vercel
# captures. Set this only when running as a container with a writable path;
# leave it empty on Vercel, where the filesystem is read-only outside /tmp.
# The sink disables itself rather than appending into a void.
LOG_PATH=

# Optional. When set, /metrics requires header: x-metrics-token: <value>
METRICS_TOKEN=

# ── Attribution ──────────────────────────────────────────────────────────
# Sent as X-FP-Source on every backend (Lambda) call, alongside X-FP-Tool
# with the tool name. The backend serves RapidAPI Hub traffic from the same
# function URL into the same log group, so without these two headers a call
# from this server is indistinguishable from a Hub call for any window.
# Reporting only -- the backend prints them and changes nothing else.
# Default "lulu"; a request that carries no header reads as "rapidapi".
FP_SOURCE=lulu

# ── Stay22 affiliate links (hotels only, free server only) ───────────────
# The booking links the hotel tools return carry Booking.com's GENERIC
# affiliate id, which attributes nothing to us. Setting STAY22_AID wraps each
# one in Stay22's /allez redirect so the click is attributed; the user still
# lands on the same property page. The original URL stays in the result as
# `booking_url` and the row is labelled `link_note`.
#
# EMPTY = OFF, and off is the shipped default: every link passes through
# byte-for-byte and the result shape does not change at all.
#
# This is the affiliate id from the Stay22 hub, NOT the LetMeAllez page
# script id (`lmaID`) -- that one only drives an in-page widget.
#
# NEVER set this on mcp_server_paid. The paid server is the ad-free,
# unmonetised product and does not read these variables.
STAY22_AID=
# Sub-id in Stay22's reporting, so free-MCP clicks are separable from any
# other surface of ours carrying Stay22 links. Default free-mcp.
STAY22_CAMPAIGN=free-mcp
